{
  "name": "dsh-task-splitter",
  "version": "0.1.1",
  "description": "DSH host plugin: detect long tasks (long-output and multi-step kinds) and auto-split them for small-context local models — scaffolds a parts skeleton or a PLAN.md ledger and injects the execution rules.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./task-parts": "./bin/task-parts.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-task-parts": "bin/task-parts.mjs"
  },
  "files": [
    "lib/index.js",
    "bin/task-parts.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "local-model",
    "long-task",
    "task-split",
    "planner",
    "small-context",
    "llama.cpp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2 || ^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Passenger-Qin/dsh-task-splitter.git"
  },
  "homepage": "https://github.com/Passenger-Qin/dsh-task-splitter#readme",
  "bugs": {
    "url": "https://github.com/Passenger-Qin/dsh-task-splitter/issues"
  }
}
